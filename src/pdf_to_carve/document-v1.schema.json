{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/markup-carve/pdf-to-carve/raw/main/src/pdf_to_carve/document-v1.schema.json",
  "title": "pdf-to-carve extraction document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "blocks"],
  "properties": {
    "version": {"const": 1},
    "title": {"type": "string", "minLength": 1},
    "author": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}},
    "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}},
    "diagnostics": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block", "page"],
      "properties": {
        "block": {"type": "integer", "minimum": 0},
        "page": {"type": "integer", "minimum": 1},
        "bbox": {
          "type": "array",
          "items": {"type": "number"},
          "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}],
          "minItems": 4,
          "maxItems": 4
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence": {"type": "string"}
      }
    },
    "inlines": {"type": "array", "items": {"$ref": "#/$defs/inline"}},
    "inline": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": {"enum": ["text", "code", "math"]},
            "text": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "children"],
          "properties": {
            "type": {"enum": ["strong", "emphasis", "underline", "strike", "highlight", "superscript", "subscript", "insert", "delete", "footnote"]},
            "children": {"$ref": "#/$defs/inlines", "minItems": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "children", "replacement"],
          "properties": {
            "type": {"const": "substitute"},
            "children": {"$ref": "#/$defs/inlines", "minItems": 1},
            "replacement": {"$ref": "#/$defs/inlines", "minItems": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "children", "url"],
          "properties": {
            "type": {"const": "link"},
            "children": {"$ref": "#/$defs/inlines", "minItems": 1},
            "url": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "listItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "content": {"$ref": "#/$defs/inlines"},
        "checked": {"type": "boolean"}
      }
    },
    "tableCell": {
      "anyOf": [
        {"$ref": "#/$defs/inlines"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["content"],
          "properties": {
            "content": {"$ref": "#/$defs/inlines"},
            "rowspan": {"type": "integer", "minimum": 1},
            "colspan": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "level", "content"],
          "properties": {
            "type": {"const": "heading"},
            "level": {"type": "integer", "minimum": 1, "maximum": 6},
            "content": {"$ref": "#/$defs/inlines"},
            "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "kind", "content"],
          "properties": {
            "type": {"const": "admonition"},
            "kind": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
            "title": {"$ref": "#/$defs/inlines"},
            "content": {"$ref": "#/$defs/inlines"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "content"],
          "properties": {
            "type": {"const": "paragraph"},
            "content": {"$ref": "#/$defs/inlines"},
            "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "items"],
          "properties": {
            "type": {"const": "list"},
            "ordered": {"type": "boolean"},
            "start": {"type": "integer", "minimum": 1},
            "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/listItem"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": {"const": "code_block"},
            "text": {"type": "string"},
            "language": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_+.#-]*$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "content"],
          "properties": {
            "type": {"const": "quote"},
            "content": {"$ref": "#/$defs/inlines"},
            "attribution": {"$ref": "#/$defs/inlines"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "headers", "rows"],
          "properties": {
            "type": {"const": "table"},
            "headers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inlines"}},
            "alignments": {
              "type": "array",
              "items": {"enum": ["left", "right", "center"]}
            },
            "rows": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/tableCell"}}},
            "caption": {"$ref": "#/$defs/inlines"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "src"],
          "properties": {
            "type": {"const": "figure"},
            "src": {"type": "string", "minLength": 1},
            "alt": {"type": "string"},
            "caption": {"$ref": "#/$defs/inlines"},
            "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"enum": ["thematic_break", "page_break"]}}
        }
      ]
    }
  }
}
